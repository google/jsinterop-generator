module(name = "sample")

bazel_dep(name = "jsinterop_generator")
bazel_dep(name = "rules_jvm_external", version = "6.6")

# Use the repository's version of jsinterop_generator.
local_path_override(
    module_name = "jsinterop_generator",
    path = "../",
)

# Maven dependencies.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
# TODO(b/532249785): we need to have a maven.install() here due to
#   https://github.com/bazel-contrib/rules_jvm_external/issues/1438
maven.install(
    # Prefer Google's Maven Central mirror to avoid Maven Central rate limiting
    # (HTTP 429), falling back to Maven Central for artifacts not yet mirrored.
    repositories = [
        "https://maven-central.storage-download.googleapis.com/maven2",
        "https://repo1.maven.org/maven2",
    ],
)

# TODO: drop this once jsinterop_base is in BCR.
bazel_dep(name = "jsinterop_base", repo_name = "com_google_jsinterop_base")
archive_override(
    module_name = "jsinterop_base",
    strip_prefix = "jsinterop-base-master",
    urls = ["https://github.com/google/jsinterop-base/archive/master.zip"],
)
